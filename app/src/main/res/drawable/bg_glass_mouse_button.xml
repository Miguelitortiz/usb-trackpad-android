<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4D38BDF8">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_active_cyan_bg" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1.5dp" android:color="@color/accent_cyan" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_tint" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="@color/glass_border_rim" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
