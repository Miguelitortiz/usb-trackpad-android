<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_cyan" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_blue" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_normal" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/border_trackpad" />
        </shape>
    </item>
</selector>
