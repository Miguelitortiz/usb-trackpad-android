<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header Bar: Title + Connection Status + Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <View
            android:id="@+id/statusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginEnd="8dp"
            android:background="@android:drawable/presence_away" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB Trackpad HID"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicializando..."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnInitUsb"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/accent_cyan"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Conectar"
            android:textAllCaps="false"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/btn_normal"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Ajustes"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mode Selector Spinner + Drag Lock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/spinnerMode"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="8dp"
            android:popupBackground="@color/bg_surface" />

        <Button
            android:id="@+id/btnDragLock"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_mouse"
            android:paddingHorizontal="12dp"
            android:text="@string/btn_drag_lock"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ADB Host & Port Row (Visible when USB ADB mode is active) -->
    <LinearLayout
        android:id="@+id/rowTcpHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="Host ADB:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHostAddress"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_trackpad_surface"
            android:hint="127.0.0.1:5057"
            android:inputType="textUri"
            android:paddingHorizontal="10dp"
            android:text="127.0.0.1:5057"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnConnectAdb"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/accent_blue"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Reconectar"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Collapsible Settings Panel -->
    <LinearLayout
        android:id="@+id/panelSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_pill"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSensitivityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sensibilidad del cursor: 1.8x"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="40"
            android:progress="18" />

        <TextView
            android:id="@+id/tvScrollLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Velocidad de Scroll (2 dedos): 1.0x"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/seekScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30"
            android:progress="10" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbNaturalScroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="false"
                android:text="Scroll natural (invertido)"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbTapToClick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Tap para clic (1 y 2 dedos)"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDiag"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@color/btn_normal"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Diagnóstico USB y Kernel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Main Multi-Touch Trackpad Surface -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_trackpad_surface">

        <com.usbtrackpad.app.TrackpadGestureView
            android:id="@+id/trackpadView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:fontFamily="monospace"
            android:text="HID [00 | 0, 0, 0]"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </FrameLayout>

    <!-- Physical Left / Middle / Right Mouse Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMouseLeft"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.3"
            android:background="@drawable/bg_button_mouse"
            android:text="@string/btn_left"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMouseMiddle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="0.8"
            android:background="@drawable/bg_button_mouse"
            android:text="@string/btn_middle"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnMouseRight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.3"
            android:background="@drawable/bg_button_mouse"
            android:text="@string/btn_right"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
